<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    JackBridge configuration.

    Installed to /Library/Application Support/JackBridge/config.plist.
    Both LaunchAgents WatchPaths this file: saving it restarts jackd and the
    daemon so the new settings take effect. No reload command needed.

    Values shown are the built-in defaults. Removing a key falls back to the
    default; deleting the whole file is equivalent to all defaults.
-->
<plist version="1.0">
<dict>
    <!-- Clock topology. Changes force a jackd restart. -->

    <!-- CoreAudio UID of the device jackd binds as its backend. This device's
         hardware sample clock paces the entire JackBridge pipeline (see
         docs/architecture.md — single-clock-domain is load-bearing).

         Empty (default) = auto-detect the Mac's built-in audio output via
         the jb-detect-builtin helper. Set explicitly to override (e.g. on a
         headless Mac mini with no built-in audio, or to clock off a stable
         external interface like a UR22C). Enumerate UIDs with:
             system_profiler SPAudioDataType
         or check `jackd -d coreaudio -l` output. -->
    <key>ClockDeviceUID</key>
    <string></string>

    <key>SampleRate</key>
    <integer>48000</integer>

    <!-- jackd backend period in frames (`-p`). MUST match the Pi-side jackd
         period — netJACK2's adaptive resampler chokes on cycle 1 with off-by-
         one `WriteResample error` when periods differ, then thrashes. pi-stomp
         ships /etc/jackdrc with `-p 64`. -->
    <key>PeriodFrames</key>
    <integer>64</integer>

    <!-- Daemon-side safety margin (in frames) added on top of `PeriodFrames`
         when projecting read/write head positions against the HAL's anchor.
         Absorbs scheduling jitter so the HAL never reads partially-written
         data. Measured envelope on Apple Silicon at 48k/64 is ±~10 frames
         steady-state with worst-case excursions up to ~75 frames during
         load transients — JitterFrames=64 leaves comfortable headroom.
         If the daemon logs guarantee-violation lines, raise this. -->
    <key>JitterFrames</key>
    <integer>64</integer>

    <!-- jackd realtime priority. 75 is load-bearing per Spike B; lowering
         this will cause xruns on any non-idle Mac. Exposed for debugging,
         not tuning. -->
    <key>RealtimePriority</key>
    <integer>75</integer>

    <!-- netJACK2 transport. Discovery is Pi-initiated multicast on the
         default group (225.3.19.154); the Mac side only advertises. MTU
         matters for jumbo-frame Ethernet — bump to 9000 only if both ends
         and every switch in between support it. -->
    <key>NetJack</key>
    <dict>
        <key>MTU</key>
        <integer>1500</integer>
    </dict>

    <!-- Interface override for the netJACK2 multicast group pin.
         Empty (default) = auto-detect (direct-cable 169.254.x preferred,
         then any wired iface with carrier, then Wi-Fi as a last resort).
         Set explicitly to e.g. `en7` to lock to a specific Thunderbolt
         dongle. Enumerate with `networksetup -listallhardwareports`.
         Editing this file kicks com.jackbridge.route, which re-pins. -->
    <key>NetworkInterface</key>
    <string></string>

    <!-- Auto-wiring inside jackd once the daemon's JACK client is up.
         ToNetmanager / FromNetmanager connect JackBridged's ports to the
         netmanager client (i.e. send/receive over the network to the Pi).
         LocalMonitoring additionally mirrors out_1/2 to system:playback_1/2
         so DAW output is audible on the Mac's own device. -->
    <key>AutoConnect</key>
    <dict>
        <key>ToNetmanager</key>
        <true/>
        <key>FromNetmanager</key>
        <true/>
        <key>LocalMonitoring</key>
        <false/>
    </dict>

    <!-- Diagnostics -->
    <key>Logging</key>
    <dict>
        <key>Level</key>
        <string>info</string>
    </dict>
</dict>
</plist>
