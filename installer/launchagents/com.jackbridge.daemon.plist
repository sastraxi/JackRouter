<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jackbridge.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/JackBridge/JackBridged</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.jackbridge.daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.jackbridge.daemon.err.log</string>
</dict>
</plist>
