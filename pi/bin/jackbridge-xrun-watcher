#!/usr/bin/env python3
"""Tails `journalctl -u jack` for netadapter ringbuffer xrun events and
maintains a bounded per-minute count file at argv[1].

File format: 15 lines, oldest first, each "<epoch_sec_of_minute> <count>".
Consumer (pi-stomp modalapi/ethernet/manager.py read_xrun_buckets) sums the
count column over the slice whose epoch is within 60/300/900s of now.

Why per-minute buckets and not per-event timestamps: a previous version
appended one line per xrun and rewrote-on-rename per event. Under load that
pegged a core, starved jackd, and amplified the xrun rate it was measuring.
Per-minute buckets bound the work to one int increment per event and at most
one file write per second regardless of xrun rate.

This process is also the service's storm-abort sentinel. If xruns arrive
faster than JACKBRIDGE_XRUN_THRESHOLD per second (sliding 1s window), we
sleep JACKBRIDGE_XRUN_GRACE seconds and exit nonzero. The systemd unit is
configured Restart=on-failure with StartLimitBurst, so this triggers a
clean service restart — which on the pi side is cheap, and lets the
netadapter come up fresh after the Mac-side HAL/SHM/daemon transient
has settled. See CLOCK_WARS.md / JITTER.md for why we want this.
"""

import collections
import os
import re
import select
import subprocess
import sys
import tempfile
import time

N_BUCKETS = 15  # 15 one-minute buckets = 15-minute window

# Storm-abort: configurable, with sane defaults. 200/sec is well above any
# benign hiccup and well below the thousands-per-second startup storm.
XRUN_THRESHOLD = int(os.environ.get("JACKBRIDGE_XRUN_THRESHOLD", "200"))
XRUN_GRACE = float(os.environ.get("JACKBRIDGE_XRUN_GRACE", "1.0"))
STORM_EXIT_CODE = 75  # EX_TEMPFAIL — non-fatal, "please restart me"

PATTERN = re.compile(r"JackRingBuffer::(Read|Write)\b.*\b(producer|consumer) too slow")


def write_file(path: str, buckets: list[int], cur_min: int) -> None:
    """Atomic rewrite: 15 lines, oldest minute first."""
    dirpath = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=dirpath, prefix=".xruns-")
    try:
        with os.fdopen(fd, "w") as f:
            for i in range(N_BUCKETS):
                m = cur_min - (N_BUCKETS - 1) + i
                f.write(f"{m * 60} {buckets[m % N_BUCKETS]}\n")
        os.rename(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: jackbridge-xrun-watcher <path-to-xrun-file>", file=sys.stderr)
        return 2
    path = sys.argv[1]

    proc = subprocess.Popen(
        ["journalctl", "-u", "jack", "-f", "-o", "cat", "-n", "0"],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    buckets = [0] * N_BUCKETS
    cur_min = int(time.time()) // 60
    dirty = True
    last_flush = 0.0
    recent = collections.deque()  # timestamps of xruns within last 1s

    try:
        assert proc.stdout is not None
        while True:
            ready, _, _ = select.select([proc.stdout], [], [], 1.0)
            now = time.time()
            now_min = int(now) // 60

            # Advance the window; zero out any minute buckets we've crossed.
            if now_min != cur_min:
                for m in range(cur_min + 1, now_min + 1):
                    buckets[m % N_BUCKETS] = 0
                cur_min = now_min
                dirty = True

            if ready:
                line = proc.stdout.readline()
                if not line:
                    break  # journalctl exited
                if PATTERN.search(line):
                    buckets[cur_min % N_BUCKETS] += 1
                    dirty = True
                    recent.append(now)
                    while recent and recent[0] < now - 1.0:
                        recent.popleft()
                    if len(recent) > XRUN_THRESHOLD:
                        print(
                            f"jackbridge-xrun-watcher: storm detected "
                            f"({len(recent)} xruns in last 1s > "
                            f"threshold {XRUN_THRESHOLD}); "
                            f"resetting buckets, sleeping {XRUN_GRACE}s, "
                            f"then exiting {STORM_EXIT_CODE} to trigger "
                            f"a clean systemd restart",
                            file=sys.stderr,
                            flush=True,
                        )
                        # Zero the file so the LCD doesn't show pre-restart
                        # counts during the brief window before
                        # jackbridge-pi-up truncates it on the next start.
                        write_file(path, [0] * N_BUCKETS, cur_min)
                        time.sleep(XRUN_GRACE)
                        return STORM_EXIT_CODE

            # Flush at most once per second. Bounds filesystem work no matter
            # how fast xruns arrive — the bug this script's previous version
            # caused was unbounded per-event writes.
            if dirty and now - last_flush >= 1.0:
                write_file(path, buckets, cur_min)
                dirty = False
                last_flush = now
    finally:
        proc.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
